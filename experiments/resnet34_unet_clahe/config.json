{
    "data_dir": "datasets/REFUGE",
    "train_csv": "datasets/REFUGE/REFUGETrain.csv",
    "val_csv": "datasets/REFUGE/REFUGE1Val.csv",
    "model": "resnet_unet",
    "backbone": "resnet34",
    "pretrained": true,
    "freeze_encoder": true,
    "unfreeze_epoch": 10,
    "base_features": 64,
    "bilinear": false,
    "epochs": 50,
    "batch_size": 8,
    "lr": 0.0001,
    "weight_decay": 0.0001,
    "target_size": 512,
    "use_clahe": true,
    "clahe_clip_limit": 2.0,
    "clahe_mode": "LAB",
    "lambda_dice": 1.0,
    "lambda_bce": 1.0,
    "save_dir": "experiments/resnet34_unet_clahe",
    "save_freq": 10,
    "resume": null,
    "device": "cuda",
    "num_workers": 4
}